[Unit]
Description=Wisselweer: landelijk advies publiceren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wisselweer
Group=wisselweer
WorkingDirectory=/opt/wisselweer
EnvironmentFile=/etc/wisselweer/wisselweer.env
# ssh/sftp zoekt ~/.ssh (known_hosts) onder HOME; sleutel en known_hosts staan in /var/lib/wisselweer/.ssh
Environment=HOME=/var/lib/wisselweer
ExecStart=/opt/wisselweer/.venv/bin/wisselweer publish
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wisselweer-publish
TimeoutStartSec=5min

# Hardening (schrijven in /var/lib/wisselweer: publicatiemap en database-cache)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wisselweer
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027
