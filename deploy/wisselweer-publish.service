[Unit]
Description=Wisselweer: landelijk advies publiceren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wisselweer
Group=wisselweer
WorkingDirectory=/opt/wisselweer
EnvironmentFile=/etc/wisselweer/wisselweer.env
# ssh/sftp zoekt ~/.ssh (known_hosts) onder HOME; sleutel en known_hosts staan in /var/lib/wisselweer/.ssh
Environment=HOME=/var/lib/wisselweer
ExecStart=/opt/wisselweer/.venv/bin/wisselweer publish
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wisselweer-publish
TimeoutStartSec=5min

# Hardening (schrijven in /var/lib/wisselweer: publicatiemap en database-cache)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wisselweer
# Voertuigfoto's zijn privé en niet nodig voor de publicatie; de publicatieservice ziet ze niet.
InaccessiblePaths=-/var/lib/wisselweer/photos
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Andere processen en /proc-onderdelen onzichtbaar; geen IPC-objecten laten staan.
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# De ssh-client (via sftp) zet bij het starten zijn eigen uid opnieuw (setresuid naar dezelfde uid);
# dat blijft toegestaan (zonder capabilities en met NoNewPrivileges kan er niets mee). Een geweigerde
# syscall geeft EPERM in plaats van het proces te doden, zodat een fout in de journal leesbaar blijft.
SystemCallFilter=setuid setgid setresuid setresgid
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0027
# Ruime grenzen; vangen een op hol geslagen proces af.
TasksMax=128
MemoryMax=512M
