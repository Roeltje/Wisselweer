[Unit]
Description=Wisselweer (bandenwisseladvies)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wisselweer
Group=wisselweer
WorkingDirectory=/opt/wisselweer
EnvironmentFile=/etc/wisselweer/wisselweer.env
ExecStart=/opt/wisselweer/.venv/bin/wisselweer serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wisselweer

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wisselweer
# De SFTP-sleutel is alleen voor wisselweer-publish.service; de webapp (internetgericht) mag hem niet lezen.
# Gevolg: publiceren via SFTP vanuit de webapp (WISSELWEER_PUBLISH_INTERVAL_HOURS) werkt niet; gebruik de timer.
InaccessiblePaths=-/var/lib/wisselweer/.ssh
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
