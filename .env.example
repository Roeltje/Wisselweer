# Wisselweer: voorbeeldconfiguratie. Kopieer naar `.env` (staat in .gitignore).
# Alle variabelen hebben het voorvoegsel WISSELWEER_.

# Waar de server op luistert. Standaard alleen lokaal; verander dit pas met toegangscontrole ervoor.
WISSELWEER_HOST=127.0.0.1
WISSELWEER_PORT=8000
# Map voor database en cache.
WISSELWEER_DATA_DIR=./data

# Contactgegeven (URL of e-mail) voor de User-Agent richting MET Norway. Verplicht voor die bron.
WISSELWEER_CONTACT=https://example.invalid/contact

# Weerbron: metno (standaard), openmeteo, brightsky, knmi
WISSELWEER_DEFAULT_PROVIDER=metno
# Zet op true bij commercieel gebruik (blokkeert de gratis Open-Meteo-host).
WISSELWEER_COMMERCIAL=false
WISSELWEER_OPENMETEO_BASE_URL=https://api.open-meteo.com
# API-sleutels (leeg laten als je de bron niet gebruikt).
WISSELWEER_OPENMETEO_API_KEY=
WISSELWEER_KNMI_API_KEY=
WISSELWEER_KNMI_STATION_ID=
WISSELWEER_WU_API_KEY=
WISSELWEER_WU_STATION_ID=
# Hoe lang (uren) een oudere verwachting nog als reserve gebruikt mag worden.
WISSELWEER_MAX_STALE_HOURS=24

# Standaardlocatie voor GET /api/v1/advice zonder coördinaten (optioneel).
WISSELWEER_DEFAULT_LATITUDE=
WISSELWEER_DEFAULT_LONGITUDE=
WISSELWEER_TIMEZONE=Europe/Amsterdam

# Geheim voor sessies (later nodig); genereer met: python -c "import secrets; print(secrets.token_urlsafe(48))"
WISSELWEER_SECRET_KEY=
# Zet op true als je achter HTTPS draait.
WISSELWEER_COOKIE_SECURE=false

# DEBUG, INFO, WARNING, ERROR
WISSELWEER_LOG_LEVEL=INFO
